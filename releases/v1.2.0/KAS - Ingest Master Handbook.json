      "id": "3cf4920d-ceba-4aff-a81f-142a89f77f1c",
      "name": "Nomalize Metadata"
    },
    {
      "parameters": {
        "jsCode": "const CHUNK_SIZE = 1200;\nconst OVERLAP = 200;\n\nconst output = [];\n\nfor (const item of $input.all()) {\n\n  const doc = item.json;\n\n  const text = doc.document || \"\";\n\n  if (!text.trim()) {\n    continue;\n  }\n\n  let chunkIndex = 0;\n  let start = 0;\n\n  while (start < text.length) {\n\n    const end = Math.min(start + CHUNK_SIZE, text.length);\n\n    output.push({\n      json: {\n\n        executionId: $execution.id,\n\n        connector: \"markdown\",\n\n        sourceName: doc.source_name,\n\n        sourceType: doc.source_type,\n\n        organization: doc.organization,\n\n        owner: doc.owner,\n\n        version: doc.version,\n\n        fileName: doc.file_name,\n\n        filePath: doc.file_path,\n\n        chunkId: `${doc.file_name}-${chunkIndex}`,\n\n        chunkIndex,\n\n        chunkText: text.substring(start, end)\n\n      }\n    });\n\n    start += (CHUNK_SIZE - OVERLAP);\n\n    chunkIndex++;\n  }\n\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
