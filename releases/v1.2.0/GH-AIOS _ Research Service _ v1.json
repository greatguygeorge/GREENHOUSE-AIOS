    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst chunks = data.chunks || [];\n\nconst formattedKnowledge = chunks.map((chunk, index) => {\n  return `### Chunk ${index + 1}\n\nSource:\n${chunk.source_name || \"Unknown\"}\n\nPackage:\n${chunk.package_name || \"Unknown\"}\n\nSimilarity Distance:\n${chunk.distance}\n\nContent:\n${chunk.content}\n`;\n}).join(\"\\n------------------------------\\n\\n\");\n\nreturn [\n  {\n    json: {\n      userRequest: $('When Executed by Another Workflow').first().json.userRequest,\n      knowledge: formattedKnowledge,\n      chunkCount: chunks.length\n    }\n  }\n];"
      },
