    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst requests = [];\n\n// Example Website sources\nconst websiteSources = [\n  {\n    id: \"website-001\",\n    name: \"NASA Climate\",\n    url: \"https://climate.nasa.gov/\"\n  }\n];\n\n// Future:\n// const rssSources = [...]\n// const googleDriveSources = [...]\n\nif (input.connectors.website.enabled) {\n  for (const source of websiteSources) {\n    requests.push({\n      json: {\n        ...input,\n\n        request: {\n          connector: \"website\",\n          source\n        }\n      }\n    });\n  }\n}\n\nreturn requests;"
      },
