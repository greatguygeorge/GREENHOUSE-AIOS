      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nreturn [{\n  json: {\n    executionId: input.executionId ?? \"\",\n    startedAt: input.startedAt ?? \"\",\n\n    request: {\n      connector: input.resource.sourceType,\n      source: {\n        id: input.resource.sourceId,\n        name: input.resource.sourceName,\n        url: input.resource.sourceUrl\n      }\n    },\n\n    extraction: {\n      contentType: input.content.contentType,\n      rawContent: input.content.rawContent,\n      contentLength: input.content.contentLength\n    },\n\n    metadata: input.metadata,\n    connector: input.connector\n  }\n}];"
      },
