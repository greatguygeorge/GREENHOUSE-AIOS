      "id": "c16d3113-50ba-43d7-854e-3eb65d7813c0",
      "name": "Send Payload(s) to Processing Pipeline",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1440,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst first = items[0]?.json || {};\n\nconst executionId = first.executionId || \"\";\nconst startedAt = first.startedAt || \"\";\n\nconst finishedAt = new Date().toISOString();\n\nlet successful = 0;\nlet failed = 0;\nlet totalChunks = 0;\nlet totalContentLength = 0;\n\nconst connectors = [];\nconst errors = [];\n\nfor (const item of items) {\n\n  const data = item.json;\n\n  connectors.push({\n    connector: data.connector,\n    source: data.source?.name || \"\",\n    status: data.status,\n    chunkCount: Number(data.chunkCount || 0),\n    contentLength: Number(data.contentLength || 0)\n  });\n\n  if (data.status === \"processed\") {\n    successful++;\n  } else {\n    failed++;\n\n    errors.push({\n      connector: data.connector,\n      source: data.source?.name || \"\",\n      reason: data.error || \"Unknown error\"\n    });\n  }\n\n  totalChunks += Number(data.chunkCount || 0);\n  totalContentLength += Number(data.contentLength || 0);\n}\n\nconst durationMs =\n  startedAt\n    ? new Date(finishedAt).getTime() - new Date(startedAt).getTime()\n    : 0;\n\nreturn [{\n  json: {\n\n    service: \"Knowledge Acquisition Service\",\n\n    version: \"1.1.0\",\n\n    executionId,\n\n    startedAt,\n\n    finishedAt,\n\n    durationMs,\n\n    status: failed === 0\n      ? \"completed\"\n      : \"completed_with_errors\",\n\n    statistics: {\n\n      connectorsExecuted: connectors.length,\n\n      successful,\n\n      failed,\n\n      totalChunks,\n\n      totalContentLength\n\n    },\n\n    connectors,\n\n    errors,\n\n    nextStage: \"Knowledge Storage Service\"\n\n  }\n}];"
      },
