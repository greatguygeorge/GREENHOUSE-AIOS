      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst rawContent = item.data || \"\";\n\nreturn [\n  {\n    json: {\n      execution: {\n        executionId: item.executionId,\n        startedAt: item.startedAt,\n        triggerType: item.triggerType,\n        service: item.service,\n        version: item.version\n      },\n\n      connector: {\n        type: \"website\",\n        name: \"Website Connector\",\n        version: \"1.0\"\n      },\n\n      resource: {\n        sourceType: \"website\",\n        sourceId: item.request.source.id,\n        sourceName: item.request.source.name,\n        sourceUrl: item.request.source.url\n      },\n\n      extraction: {\n        contentType: item.headers?.[\"content-type\"] || \"text/html\",\n        rawContent: rawContent,\n        contentLength: rawContent.length,\n        retrievedAt: new Date().toISOString()\n      },\n\n      metadata: {\n        statusCode: item.statusCode,\n        headers: item.headers,\n        status: item.statusCode === 200 ? \"success\" : \"failed\"\n      }\n    }\n  }\n];"
      },
