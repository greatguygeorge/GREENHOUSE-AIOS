          "id": "68TAGnlr7XZFwI7n",
          "name": "Google Gemini(PaLM) Api account 6"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Formats the embedding array as a pgvector literal string (e.g. \"[0.01,0.02,...]\")\n// and assembles the full row ready for insertion.\nconst prev = $('Split Into Chunk Items').item.json;\nconst embeddingValues = $json.embedding && $json.embedding.values;\n\nif (!Array.isArray(embeddingValues)) {\n  throw new Error('Knowledge Storage Service: Gemini API did not return embedding.values as an array.');\n}\n\nconst embeddingLiteral = '[' + embeddingValues.join(',') + ']';\n\nreturn [{\n  json: {\n    text: prev.chunkText,\n    metadata: {\n      executionId: prev.executionId,\n      connector: prev.connector,\n      sourceId: prev.sourceId,\n      sourceName: prev.sourceName,\n      sourceUrl: prev.sourceUrl,\n      chunkId: prev.chunkId,\n      chunkIndex: prev.chunkIndex,\n      embeddedAt: new Date().toISOString(),\n      embeddingModel: 'gemini-embedding-001'\n    },\n    embedding: embeddingLiteral\n  }\n}];"
      },
