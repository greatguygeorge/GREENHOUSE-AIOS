    {
      "parameters": {
        "jsCode": "// Confirmed contract from GH-AIOS | KAS | Knowledge Processing Pipeline | v1.0's\n// \"Return Processing Summary\" node, after the field-mapping fixes:\n//   executionId, connector, sourceId, sourceName, sourceUrl,\n//   status, completedAt, chunkCount, chunks: [{ id, index, text }]\nconst result = $input.first().json.processingResult;\n\nif (!result || !Array.isArray(result.chunks)) {\n  throw new Error('Knowledge Storage Service: processingResult.chunks is missing or not an array.');\n}\n\nreturn result.chunks.map(chunk => ({\n  json: {\n    executionId: result.executionId,\n    connector: result.connector,\n    sourceId: result.sourceId,\n    sourceName: result.sourceName,\n    sourceUrl: result.sourceUrl,\n    chunkId: chunk.id,\n    chunkIndex: chunk.index,\n    chunkText: chunk.text\n  }\n}));"
      },
      "id": "87fde56b-92ed-4af9-a8f3-2031145059da",
      "name": "Split Into Chunk Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-001:embedContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { content: { parts: [ { text: $json.chunkText } ] } } }}",
        "options": {}
      },
      "id": "03771499-fa51-4c63-9ca8-aaa23a26db01",
      "name": "Generate Embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
