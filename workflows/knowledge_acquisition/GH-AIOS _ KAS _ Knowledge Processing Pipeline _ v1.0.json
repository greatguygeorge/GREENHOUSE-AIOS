      "id": "7dc90131-d3de-4ff1-aae9-193888b2fcee",
      "name": "Initialize Processing Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst required = [\n  \"executionId\",\n  \"request\",\n];\n\nfor (const field of required) {\n  if (!(field in item)) {\n    throw new Error(`Missing required field: ${field}`);\n  }\n}\n\nif (!item.request.connector) {\n  throw new Error(\"Missing connector.\");\n}\n\nif (!item.request.source) {\n  throw new Error(\"Missing source.\");\n}\n\nif (!item.extraction) {\n  throw new Error(\"No extracted content received.\");\n}\n\nif (!item.extraction.rawContent) {\n  throw new Error(\"rawContent missing.\");\n}\n\nreturn $input.all();"
      },
      "id": "d973fcd5-f232-4b53-b167-8e440b266451",
      "name": "Validate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nitem.document = {\n  id: item.sourceId,\n  title: item.sourceName,\n  source: item.connector,\n  url: item.sourceUrl,\n  content: item.extraction.rawContent,\n  contentType: item.extraction.contentType,\n  retrievedAt: item.extraction.retrievedAt,\n};\n\nreturn [{\n  json: item\n}];"
      },
      "id": "1478f554-ac9c-4771-9694-f25029316852",
      "name": "Normalize Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nlet text = item.document.content;\n\n// remove scripts\ntext = text.replace(/<script[\\s\\S]*?<\\/script>/gi, \"\");\n\n// remove styles\ntext = text.replace(/<style[\\s\\S]*?<\\/style>/gi, \"\");\n\n// remove html tags\ntext = text.replace(/<[^>]+>/g, \" \");\n\n// collapse whitespace\ntext = text.replace(/\\s+/g, \" \").trim();\n\nitem.document.cleanedContent = text;\n\nreturn [{\n  json: item\n}];"
      },
      "id": "3d78a5dd-c1e6-4d96-975b-9459c75f726d",
      "name": "Clean Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst text = item.document.cleanedContent;\n\nconst CHUNK_SIZE = 1200;\n\nconst chunks = [];\n\nfor (let i = 0; i < text.length; i += CHUNK_SIZE) {\n\n  chunks.push({\n    id: `${item.document.id}-${chunks.length}`,\n    index: chunks.length,\n    text: text.slice(i, i + CHUNK_SIZE)\n  });\n\n}\n\nitem.document.chunks = chunks;\nitem.document.chunkCount = chunks.length;\n\nreturn [{\n  json: item\n}];"
      },
      "id": "6b94de1e-941d-45d9-afd1-c0e793d73cfe",
      "name": "Chunk Document",
      "type": "n8n-nodes-base.code",
