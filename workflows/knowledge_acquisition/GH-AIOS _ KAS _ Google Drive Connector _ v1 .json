      },
      "id": "f053f69a-5f44-4deb-9ef1-b9cf7d1dc7c9",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Reads from job.request.source, same contract as Website and RSS Connectors:\n// { id, name, url } — where for Google Drive, \"url\" may be a raw file ID\n// or a full Drive sharing link.\nconst job = $input.first().json.job;\nconst source = job && job.request && job.request.source;\n\nif (!source || !source.url) {\n  throw new Error('Google Drive Connector: job.request.source.url (file ID or Drive link) is missing.');\n}\n\nconst raw = String(source.url).trim();\nlet fileId = null;\n\nconst dMatch = raw.match(/\\/d\\/([a-zA-Z0-9_-]+)/);\nconst idParamMatch = raw.match(/[?&]id=([a-zA-Z0-9_-]+)/);\n\nif (dMatch) {\n  fileId = dMatch[1];\n} else if (idParamMatch) {\n  fileId = idParamMatch[1];\n} else if (/^[a-zA-Z0-9_-]{10,}$/.test(raw)) {\n  fileId = raw;\n} else {\n  throw new Error(`Google Drive Connector: could not extract a file ID from \"${raw}\".`);\n}\n\nreturn [{\n  json: {\n    executionId: job.executionId,\n    sourceId: source.id || null,\n    title: source.name || '',\n    driveUrl: raw,\n    fileId\n  }\n}];"
      },
      "id": "0021d125-1e99-4d52-a6a6-bbb1be30e7ce",
      "name": "Receive Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.fileId }}",
          "mode": "id"
        },
        "options": {
          "googleFileConversion": {
            "conversion": {
              "docsToFormat": "text/plain"
            }
          }
        }
      },
      "id": "d555a1fd-f3e1-47be-bcd8-0fac59029557",
      "name": "Download File",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        480,
        0
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "Rzp02emGmpAbCv9N",
          "name": "Google Drive account 5"
        }
      }
    },
    {
      "parameters": {
        "operation": "text",
        "options": {}
      },
      "id": "88cf098d-2a02-4431-99a6-e9e46f445205",
      "name": "Extract File Content",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
