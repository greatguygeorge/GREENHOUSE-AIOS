              "type": "string",
              "value": "={{ $json.text || $json.data }}"
            },
            {
              "id": "bsp5",
              "name": "retrievedAt",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            },
            {
              "id": "bsp6",
              "name": "connectorMetadata",
              "type": "object",
              "value": "={{ { fileId: $('Receive Request').item.json.fileId, mimeType: $('Download File').item.json.mimeType || null } }}"
            }
          ]
        },
        "options": {}
      },
      "id": "914988d2-0d70-43e6-bb8f-62280ddc8245",
